# One deploy tick: fast-forward the serving checkout to origin/main. The
# static tree is volume-mounted, so the pull IS the deploy — deliberately NO
# compose call here: podman-compose's `up -d` is not idempotent (it recreates
# running containers, a micro-outage per tick). After a docker-compose.yml
# change, restart the stacks once: systemctl --user restart panoramax-stacks.
[Unit]
Description=panoramax deploy: pull main into the serving checkout

[Service]
Type=oneshot
WorkingDirectory=%h/serve/maplibre-gl-panoramax
ExecStart=/usr/bin/git pull --ff-only
